{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "src/detection_system/web",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/mobile",
      "destination": "/index.html"
    },
    {
      "source": "/mobile.html",
      "destination": "/index.html"
    },
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
